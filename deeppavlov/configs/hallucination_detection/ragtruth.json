{
    "dataset_reader": {
        "class_name": "ragtruth_reader",
        "data_path": "{DOWNLOADS_PATH}/ragtruth",
        "language": "en",
        "preprocess_raw": true,
        "save_preprocessed": true,
        "validation_split": 0.15,
        "random_seed": 42,
        "create_validation_from_train": true,
        "debug_format": false
    },
    "dataset_iterator": {
        "class_name": "data_learning_iterator"
    },
    "chainer": {
        "in": ["x"],
        "in_y": ["y"],
        "pipe": [
            {
                "class_name": "torch_transformers_hallucination_detector_preprocessor",
                "tokenizer": "{TRANSFORMER}",
                "do_lower_case": false,
                "max_seq_length": 4096,
                "in": ["x"],
                "out": [
                    "input_ids",
                    "attention_mask",
                    "y_masks",
                    "labels"
                ]
            },
            {
                "class_name": "torch_transformers_sequence_tagger",
                "n_tags": 2,
                "pretrained_bert": "{TRANSFORMER}",
                "attention_probs_keep_prob": 0.5,
                "use_crf": false,
                "optimizer": "AdamW",
                "optimizer_parameters": {
                    "lr": 1e-05,
                    "weight_decay": 1e-03,
                    "betas": [
                        0.9,
                        0.999
                    ],
                    "eps": 1e-06
                },
                "clip_norm": 1.0,
                "min_learning_rate": 1e-06,
                "learning_rate_drop_patience": 5,
                "learning_rate_drop_div": 1.5,
                "load_before_drop": true,
                "save_path": "{MODEL_PATH}/model",
                "load_path": "{MODEL_PATH}/model",
                "in": [
                    "input_ids",
                    "attention_mask",
                    "y_masks"
                ],
                "in_y": ["labels"],
                "out": [
                    "y_pred",
                    "probas"
                ]
            }
        ],
        "out": [
        "y_pred",
        "probas"
        ]
    },
    "train": {
        "epochs": 6,
        "batch_size": 4,
        "metrics": [
            {
                "name": "token_classification_accuracy",
                "inputs": [
                    "y",
                    "y_pred"
                ]
            },
            {
                "name": "token_classification_f1",
                "inputs": [
                    "y",
                    "y_pred"
                ]
            }
        ],
        "validation_patience": 50,
        "val_every_n_batches": 10,
        "log_every_n_batches": 10,
        "show_examples": false,
        "evaluation_targets": [
            "test",
            "valid"
        ],
        "class_name": "torch_trainer",
        "tensorboard_log_dir": "{MODEL_PATH}/metrics"
    },
    "metadata": {
        "variables": {
            "ROOT_PATH": "/root/.deeppavlov",
            "DOWNLOADS_PATH": "{ROOT_PATH}/downloads",
            "MODELS_PATH": "{ROOT_PATH}/models",
            "MODEL_PATH": "{MODELS_PATH}/ragtruth_hallucination_detector",
            "TRANSFORMER": "answerdotai/ModernBERT-base",
            "LETTUCE": "KRLabsOrg/lettucedect-base-modernbert-en-v1",
            "ORIGINAL": "answerdotai/ModernBERT-base"

        },
        "download": []
    }
}
