{
    "dataset_reader": {
        "class_name": "ragtruth_reader",
        "data_path": "{DOWNLOADS_PATH}/ragtruth",
        "language": "en",
        "preprocess_raw": true,
        "save_preprocessed": true,
        "validation_split": 0.10,
        "random_seed": 42,
        "create_validation_from_train": true,
        "debug_format": false
    },
    "dataset_iterator": {
        "class_name": "data_learning_iterator"
    },
    "chainer": {
        "in": ["context_raw", "question_raw", "answer_raw"],
        "in_y": ["y"],
        "pipe": [
            {
                "class_name": "torch_transformers_hallucination_detector_preprocessor",
                "tokenizer": "{TRANSFORMER}",
                "do_lower_case": false,
                "max_seq_length": 2000,
                "in": [
                    "context_raw",
                    "question_raw",
                    "answer_raw"
                ],
                "out": [
                    "input_ids",
                    "attention_mask",
                    "labels",
                    "prompts"
                ]
            },
            {
                "class_name": "torch_transformers_hallucination_detector",
                "pretrained_bert": "{TRANSFORMER}",
                "optimizer": "AdamW",
                "trust_remote_code": true,
                "optimizer_parameters": {
                    "lr": 1e-05,
                    "weight_decay": 1e-03,
                    "betas": [
                        0.9,
                        0.999
                    ],
                    "eps": 1e-06
                },
                "clip_norm": 1.0,
                "min_learning_rate": 1e-06,
                "learning_rate_drop_patience": 10,
                "learning_rate_drop_div": 1.2,
                "load_before_drop": true,
                "save_path": "{MODEL_PATH}/model",
                "load_path": "{MODEL_PATH}/model",
                "in": [
                    "input_ids",
                    "attention_mask"
                ],
                "in_y": ["labels"],
                "out": [
                    "y_pred",
                    "probas"
                ]
            },
            {
                "class_name": "torch_transformers_hallucination_detector_postprocessor",
                "tokenizer": "{TRANSFORMER}",
                "max_seq_length": 4096,
                "in": [
                    "answer_raw",
                    "prompts",
                    "y_pred",
                    "probas",
                    "labels"
                ],
                "out": [
                    "ans_predicted"
                ]
            }
        ],
        "out": [
            "ans_predicted"
        ]
    },
    "train": {
        "epochs": 2,
        "batch_size": 4,
        "metrics": [
            {
                "name": "token_binary_f1",
                "inputs": [
                    "labels",
                    "y_pred"
                ]
            },
            {
                "name": "token_binary_precision",
                "inputs": [
                    "labels",
                    "y_pred"
                ]
            },
            {
                "name": "token_binary_recall",
                "inputs": [
                    "labels",
                    "y_pred"
                ]
            }
        ],
        "validation_patience": 100,
        "val_every_n_batches": 500,
        "log_every_n_batches": 200,
        "show_examples": false,
        "evaluation_targets": [
            "test",
            "valid"
        ],
        "class_name": "torch_trainer",
        "tensorboard_log_dir": "{MODEL_PATH}/metrics"
    },
    "metadata": {
        "variables": {
            "ROOT_PATH": "~/.deeppavlov",
            "DOWNLOADS_PATH": "{ROOT_PATH}/downloads",
            "MODELS_PATH": "{ROOT_PATH}/models",
            "TRANSFORMER": "microsoft/mdeberta-v3-base",
            "MODEL_PATH": "{MODELS_PATH}/hallucination_detection"
        },
    "download": [
      {
        "url": "http://files.deeppavlov.ai/tmp/ragtruth/ragtruth.tar.gz",
        "subdir": "{DOWNLOADS_PATH}/ragtruth"
      },
      {
        "url": "http://files.deeppavlov.ai/tmp/hallucination_detection/hallucination_detection_model.tar.gz",
        "subdir": "{MODELS_PATH}/hallucination_detection"
      }
    ]
  }
}
