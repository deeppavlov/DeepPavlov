{
  "dataset_reader": {
    "class_name": "basic_classification_reader",
    "x": "English",
    "y": "is_evergreen",
    "data_path": "/cephfs/home/korzanova/rag_classifier/Evergreen_dataset/for_train"
  },
  "dataset_iterator": {
    "class_name": "basic_classification_iterator",
    "seed": 42
  },
  "chainer": {
    "in": ["x"],
    "in_y": ["y"],
    "pipe": [
      {
        "class_name": "torch_transformers_preprocessor",
        "vocab_file": "{BASE_MODEL}",
        "do_lower_case": false,
        "max_seq_length": 64,
        "in": ["x"],
        "out": ["bert_features"]
      },
      {
        "id": "classes_vocab",
        "class_name": "simple_vocab",
        "fit_on": ["y"],
        "save_path": "{MODEL_PATH}/classes.dict",
        "load_path": "{MODEL_PATH}/classes.dict",
        "in": ["y"],
        "out": ["y_ids"]
      },
      {
        "in": ["y_ids"],
        "out": ["y_onehot"],
        "class_name": "one_hotter",
        "depth": "#classes_vocab.len",
        "single_vector": true
      },
      {
        "class_name": "torch_transformers_classifier",
        "n_classes": "#classes_vocab.len",
        "return_probas": true,
        "pretrained_bert": "{BASE_MODEL}",
        "save_path": "{MODEL_PATH}/model/bert_model",
        "load_path": "{MODEL_PATH}/model/bert_model",
        "optimizer": "AdamW",
        "optimizer_parameters": {
          "lr": 4.6e-05,
          "weight_decay": 1e-06,
          "betas": [0.9, 0.999],
          "eps": 1e-06
        },
        "learning_rate_drop_patience": 3,
        "learning_rate_drop_div": 2.0,
        "in": ["bert_features"],
        "in_y": ["y_ids"],
        "out": ["y_pred_probas"]
      },
      {
        "in": ["y_pred_probas"],
        "out": ["y_pred_ids"],
        "class_name": "proba2labels",
        "max_proba": true
      },
      {
        "in": ["y_pred_ids"],
        "out": ["y_pred_labels"],
        "ref": "classes_vocab"
      }
    ],
    "out": ["y_pred_labels"]
  },
  "train": {
    "epochs": 30,
    "batch_size": 64,
    "metrics": [
      "f1_weighted",
      "f1_macro"
    ],
    "validation_patience": 15,
    "val_every_n_epochs": 1,
    "log_every_n_epochs": 1,
    "show_examples": false,
    "evaluation_targets": ["valid", "test"],
    "class_name": "torch_trainer",
    "tensorboard_log_dir": "{MODEL_PATH}/metrics/bert_mult",
    "pytest_max_batches": 2
  },
  "metadata": {
    "variables": {
      "BASE_MODEL": "google-bert/bert-base-multilingual-cased",
      "ROOT_PATH": "~/.deeppavlov",
      "DOWNLOADS_PATH": "{ROOT_PATH}/downloads",
      "MODELS_PATH": "{ROOT_PATH}/models",
      "MODEL_PATH": "/cephfs/home/korzanova/rag_classifier/model/bert_model"
    }
  }
}
